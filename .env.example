# Copy to .env and fill the two Alpaca keys.
# Never commit .env.
ALPACA_API_KEY=your_paper_key_id
ALPACA_SECRET_KEY=your_paper_secret

# Market data: iex is free. sip requires an Alpaca data subscription;
# you can also override per run with --feed sip.
TPI_ALPACA_FEED=iex

# Live trading is refused unless this is true AND --i-understand-live-risk is
# passed AND the typed LIVE confirmation is entered at the terminal.
TPI_ALLOW_LIVE=false

# Optional paths
# TPI_CACHE_PATH=data/tpi_cache.db
# TPI_REPORTS_DIR=reports
# TPI_CACHE_TTL_HOURS=12

# Logging (console modes only)
RUST_LOG=warn
